    "preserveHistoricalSamples": true
  },
  "rendering": {
    "renderMode": "IMAGE_AND_TEXT",
    "rendererArchitecture": "ONE_INDEPENDENT_RENDERER_PER_PHYSICAL_SCREEN",
    "separateFromFullScreenOS": true,
    "useDedicatedCanvasPerScreen": true,
    "useDedicatedTexturePerScreen": true,
    "showHeader": true,
    "showFooter": true,
    "showScreenTitle": true,
    "showSubsystemLabel": true,
    "showTimestamp": true,
    "showTelemetryState": true,
    "showUnits": true,
    "showLegends": true,
    "showGridLines": true,
    "showDataQualityIndicators": true,
    "showAlertSeverity": true,
    "showPageIndicators": true,
    "showLoadingState": true,
    "showErrorState": true,
    "showNoDataState": true,
    "showOfflineState": true,
    "verifyMeshTransformBeforeRendering": true,
    "orientationSource": "CONFIG",
    "allowPerScreenOrientation": true,
    "preserveScreenAspectRatio": true,
    "avoidDistortingText": true,
    "avoidExcessiveBloom": true,
    "avoidNeonOveruse": true,
    "renderPriority": "VISIBLE_PHYSICAL_SCREENS",
    "fallbackOnRendererFailure": "SHOW_LOCAL_ERROR_PANEL",
    "sharedDataDoesNotMeanSharedRenderer": true
  },
  "visualTheme": {
    "background": "#07111F",
    "backgroundSecondary": "#0B1B2B",
    "panel": "#102438",
    "panelElevated": "#152D42",
