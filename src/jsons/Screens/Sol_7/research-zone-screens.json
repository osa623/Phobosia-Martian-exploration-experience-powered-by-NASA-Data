    "waterColor": "#50BFE8",
    "gridColor": "#1B354B",
    "fontStyle": "TECHNICAL_SCIENTIFIC_SANS",
    "numericFontStyle": "MONOSPACED",
    "panelStyle": "COMPACT_TELEMETRY_DASHBOARD",
    "cornerStyle": "SUBTLE",
    "chartStyle": "THIN_LINES_WITH_CLEAR_LEGENDS",
    "warningStyle": "COLOR_AND_TEXT_LABEL",
    "criticalStyle": "COLOR_AND_TEXT_LABEL",
