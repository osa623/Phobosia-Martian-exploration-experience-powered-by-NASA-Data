    "dataMode": "SIMULATED_DEMO",
    "displayDisclaimer": true,
    "disclaimerText": "SIMULATED RESEARCH DATA - NOT LIVE NASA TELEMETRY",
    "nasaAlignment": "NASA-inspired scientific workflows and Mars mission research concepts",
    "realDataIntegrationRequired": true,
    "allowUnverifiedLiveClaims": false,
    "unitsRequired": true,
    "timestampRequired": true,
    "missingValueDisplay": "N/A",
