{
  "project": "PHOBOSIA",
  "zone": "MISSION_CONTROL",
  "configVersion": "1.0.0-sol4",
  "dataPolicy": {
    "mode": "SIMULATED_DEMO",
    "liveTelemetry": false,
    "disclaimer": "SIMULATED MISSION DATA - NOT LIVE NASA TELEMETRY",
    "scientificIntegrity": "Use scientifically plausible Mars mission values for demonstration. Do not present simulated readings as real NASA measurements.",
    "units": {
      "distance": "m",
      "temperature": "°C",
      "pressure": "kPa",
      "power": "W",
      "energy": "Wh",
      "percentage": "%",
      "time": "Sol / mission elapsed time"
    }
  },
  "rendering": {
    "rendererId": "MissionControlScreenRenderer",
    "renderMode": "PHYSICAL_SCREEN",
    "independentScreenRendering": true,
    "fullscreenOSSeparation": true,
    "screenContentSource": "JSON",
    "updateStrategy": "UPDATE_CHANGED_CONTENT_ONLY",
    "textureStrategy": "REUSE_CANVAS_TEXTURES",
    "allowScreenSpecificOrientation": true,
    "preserveBlenderMeshNames": true,
    "fallbackOnMissingData": "SHOW_DIAGNOSTIC_PLACEHOLDER",
    "fallbackOnMissingMesh": "LOG_ERROR_AND_CONTINUE"
  },
  "visualTheme": {
    "style": "NASA_INSPIRED_MARS_MISSION_CONTROL",
    "background": "#08111B",
    "panelBackground": "#101D2A",
    "primaryText": "#E7F0F7",
    "secondaryText": "#8FA8BC",
    "accent": "#E5A04B",
