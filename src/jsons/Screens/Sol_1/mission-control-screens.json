{
  "project": "PHOBOSIA",
  "zone": "MISSION_CONTROL",
  "configVersion": "1.0.0",
  "dataPolicy": {
    "mode": "SIMULATED_DEMO",
    "liveTelemetry": false,
    "disclaimer": "SIMULATED MISSION DATA - NOT LIVE NASA TELEMETRY",
    "scientificIntegrity": "Use scientifically plausible Mars mission values for demonstration. Do not present simulated readings as real NASA measurements.",
    "units": {
      "distance": "m",
      "temperature": "°C",
      "pressure": "kPa",
      "power": "W",
      "energy": "Wh",
      "percentage": "%",
      "time": "Sol / mission elapsed time"
    }
  },
  "rendering": {
    "rendererId": "MissionControlScreenRenderer",
    "renderMode": "PHYSICAL_SCREEN",
    "independentScreenRendering": true,
    "fullscreenOSSeparation": true,
    "screenContentSource": "JSON",
    "updateStrategy": "UPDATE_CHANGED_CONTENT_ONLY",
    "textureStrategy": "REUSE_CANVAS_TEXTURES",
    "allowScreenSpecificOrientation": true,
    "preserveBlenderMeshNames": true,
    "fallbackOnMissingData": "SHOW_DIAGNOSTIC_PLACEHOLDER",
    "fallbackOnMissingMesh": "LOG_ERROR_AND_CONTINUE"
  },
  "visualTheme": {
    "style": "NASA_INSPIRED_MARS_MISSION_CONTROL",
    "background": "#08111B",
    "panelBackground": "#101D2A",
    "primaryText": "#E7F0F7",
    "secondaryText": "#8FA8BC",
    "accent": "#E5A04B",
    "success": "#5BC69A",
    "warning": "#F0BD55",
    "critical": "#F16B66",
    "grid": "#24394B",
    "fontFamily": "monospace",
    "avoidExcessiveAnimation": true,
    "avoidNeonEffects": true,
    "highContrast": true
  },
  "globalLayout": {
    "headerHeightRatio": 0.14,
    "footerHeightRatio": 0.09,
    "outerPaddingRatio": 0.035,
    "panelGapRatio": 0.025,
    "minimumTextScale": 0.65,
    "showScreenTitle": true,
    "showMissionSol": true,
    "showSimulationIndicator": true,
    "showTimestamp": true,
    "showStatusLegendWhenRelevant": true
  },
  "orientationDefaults": {
    "mirrorHorizontal": false,
    "mirrorVertical": false,
    "rotationDegrees": 0,
    "useConfiguredOrientationOnlyWhenVerified": true,
    "allowPerScreenOverride": true,
    "doNotGuessBlenderTransform": true
  },
  "missionContext": {
    "missionName": "PHOBOSIA Mars Observation Mission",
    "missionSol": 1,
    "missionDurationSols": 14,
    "missionPhase": "OUTPOST_ORIENTATION",
    "primaryGoal": "Explore the existing outpost and complete the required orientation checklist.",
    "dayProgressionPolicy": "Mission sol advances only through the gameplay progression system, not because a display refreshes.",
    "crossZoneIntegration": {
      "habitat": "Use compatible shared mission-state data when available.",
      "engineering": "Read engineering and power-system state through the existing application data layer.",
      "researchLab": "Read science experiment state through the existing application data layer.",
      "centralHub": "Expose a compact operational summary for Central Hub status displays.",
      "doNotDuplicateAuthoritativeState": true
    }
  },
  "sections": [
    {
      "sectionId": "SECTION_01",
      "sectionName": "MISSION_OVERVIEW_AND_OBJECTIVES",
      "purpose": "Mission planning, objective tracking, and high-level outpost awareness."
    },
    {
      "sectionId": "SECTION_02",
      "sectionName": "COMMUNICATIONS_AND_SYSTEMS",
      "purpose": "Communication link status, subsystem health, and operational alerts."
    },
    {
      "sectionId": "SECTION_03",
      "sectionName": "DRONE_AND_TERRAIN_OPERATIONS",
      "purpose": "Drone and terrain displays are retained for their established roles; no target selection or flight is active in Sol 1 or Sol 2."
    }
  ],
  "screens": [
    {
