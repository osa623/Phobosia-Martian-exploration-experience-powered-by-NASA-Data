{
  "project": "PHOBOSIA",
  "zone": "CENTRAL_HUB",
  "configVersion": "1.0.0",
  "dataPolicy": {
    "mode": "SIMULATED_DEMO",
    "liveTelemetry": false,
    "disclaimer": "SIMULATED OUTPOST DATA - NOT LIVE NASA TELEMETRY",
    "scientificIntegrity": "Display simulated values as demonstration data unless connected to an actual application data source."
  },
  "rendering": {
    "rendererId": "CentralHubScreenRenderer",
    "renderMode": "PHYSICAL_SCREEN",
    "independentScreenRendering": true,
    "fullscreenOSSeparation": true,
    "screenContentSource": "JSON",
    "updateStrategy": "UPDATE_CHANGED_CONTENT_ONLY",
    "textureStrategy": "REUSE_CANVAS_TEXTURES",
    "preserveBlenderMeshNames": true,
    "allowScreenSpecificOrientation": true,
    "missingDataPolicy": "USE_FALLBACK_AND_LOG",
    "missingMeshPolicy": "LOG_ERROR_AND_CONTINUE"
  },
  "visualTheme": {
    "style": "MARS_OUTPOST_SHARED_OPERATIONS",
    "background": "#08111B",
    "panelBackground": "#111F2C",
    "primaryText": "#E7F0F7",
    "secondaryText": "#92A9BC",
    "accent": "#E5A04B",
    "success": "#5BC69A",
    "warning": "#F0BD55",
    "critical": "#F16B66",
    "grid": "#24394B",
    "fontFamily": "monospace",
    "highContrast": true,
    "avoidNeonEffects": true
  },
  "globalLayout": {
    "showScreenTitle": true,
    "showTimestamp": true,
    "showSimulationIndicator": true,
    "showStatusLegendWhenRelevant": true,
    "preserveAspectRatio": true,
    "avoidOverflow": true,
    "fitContentToActualScreenAspectRatio": true
  },
  "orientationDefaults": {
    "mirrorHorizontal": false,
    "mirrorVertical": false,
    "rotationDegrees": 0,
    "verifyAgainstBlender": true,
    "doNotGuessMissingCoordinates": true
  },
  "missionContext": {
    "missionName": "PHOBOSIA Mars Observation Mission",
    "missionDurationSols": 14,
    "purpose": "Provide a shared status and communication point linking Habitat, Mission Control, Science Lab, and Engineering Unit.",
    "crossZoneIntegration": {
      "readExistingStateWhenAvailable": true,
      "avoidDuplicateAuthoritativeState": true,
      "doNotAdvanceMissionSolOnDisplayRefresh": true,
      "doNotCreateFakeLiveTelemetry": true
    }
  },
