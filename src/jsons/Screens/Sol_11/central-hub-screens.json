  "centralHubSceneValidation": {
    "kaleidosSection": {
      "enabled": true,
      "validationRequired": true,
      "goal": "Verify that the recently updated Kaleidos section is present in the loaded Central Hub model and renders correctly.",
      "checks": [
        "Locate the updated Kaleidos section in the actual loaded scene graph.",
        "Verify its expected mesh objects exist and are not hidden or excluded from rendering.",
        "Verify geometry and material assignments are valid.",
        "Verify transforms, parent-child relationships, and scale are correct.",
        "Verify material visibility under the actual scene lighting.",
        "Verify no unintended clipping, z-fighting, or overlap hides the section.",
        "Verify the section remains present after model loading and scene initialization.",
        "Capture a development diagnostic if any check fails."
      ],
      "doNot": [
        "Do not recreate the Kaleidos section if the updated model already contains it.",
        "Do not rename its existing Blender objects without a demonstrated technical requirement.",
        "Do not replace its geometry or materials merely to hide a rendering bug.",
        "Do not report success without checking the loaded scene."
      ]
    },
    "lights": {
      "enabled": true,
      "namePattern": "^Lights_\\d+$",
      "caseInsensitive": true,
      "validationRequired": true,
      "goal": "Find every intended Central Hub light object, confirm its runtime type and scene attachment, and repair missing or invalid light setup without creating duplicate lights.",
      "checks": [
        "Traverse the loaded Central Hub scene graph recursively and collect objects matching the configured light-name pattern.",
        "Also inspect exact names beginning with 'Lights_' in case their suffix format differs from the numeric pattern.",
        "For each matching object, verify whether it is an actual THREE.Light or a mesh/empty used as a light marker.",
        "Verify the light is attached to the active scene graph and is not unintentionally hidden.",
        "Verify intensity, color, distance, decay, angle, and shadow settings where applicable to the actual light type.",
        "Verify parent transforms and world position.",
        "Check whether the renderer and material configuration can show the expected illumination.",
        "Check whether ambient lighting, exposure, tone mapping, material settings, or shadow settings prevent visible results.",
        "Avoid enabling shadows on every light when that would harm performance.",
        "If an object is only a marker and not a light, preserve the marker and create a real light only when required by the intended scene design.",
        "Avoid duplicate lights when a valid light already exists."
      ],
      "repairPolicy": {
        "preserveExistingValidLights": true,
        "createMissingLightOnlyWhenRequired": true,
        "inferLightTypeFromExistingEvidence": true,
        "doNotBlindlyConvertEveryMarkerToPointLight": true,
        "preserveNames": true,
        "preserveExistingTransformsWhereValid": true,
        "logEveryRepair": true
      },
      "performance": {
        "respectLowEndGpu": true,
        "useShadowCastingSelectively": true,
        "avoidExcessiveDynamicLights": true,
        "preferEfficientLightingConfiguration": true
      }
    }
  },
  "rendererRules": {
    "screenRegistration": "Register all screens by exact meshName and screenId.",
    "panelRendering": "Use a shared panel registry or compatible adapter, but keep Central Hub's renderer independent from the other zone renderers.",
    "supportedPanelTypes": [
      "STATUS_MATRIX",
      "METRIC_GRID",
      "ALERT_LIST",
      "COMPONENT_STATUS",
      "EVENT_FEED",
      "STATUS_CARD"
    ],
    "portraitLayout": "The Internal_Communication_Display should use a vertical layout based on its actual screen aspect ratio.",
    "dataBinding": "Resolve existing application state safely and use fallback data only when the intended source is unavailable.",
    "materialAssignment": "Assign display textures only to the intended display surface.",
    "textureUpdates": "Reuse textures and redraw only when content changes.",
    "orientation": "Apply screen mirroring and rotation once; verify against Blender UVs and actual mesh orientation.",
    "failureIsolation": "A missing screen or invalid panel must not prevent the remaining Central Hub screens from rendering."
  },
  "performance": {
    "targetHardware": "NVIDIA MX350 2GB VRAM, 12GB RAM",
    "reuseCanvasTextures": true,
    "avoidUnnecessaryFullSceneRenders": true,
    "avoidExcessiveDynamicLights": true,
    "disposeReplacedTextures": true,
    "avoidUnboundedAnimationLoops": true
  }
}
