{
  "missionId": "PHOBOSIA_SOL_03",
  "sol": 3,
  "title": "Scientific Target Selection",
  "subtitle": "Select a Mars observation target and establish a research objective.",
  "missionType": "trigger_scoped_scientific_investigation",
  "description": "Use Mission Control and Research Lab interfaces to review available Mars observation sites, examine operational constraints, select a scientific target, evaluate available datasets, and submit a justified observation proposal.",
  "prerequisites": {
    "completedMissions": ["PHOBOSIA_SOL_02"]
  },
  "progression": {
    "completionUnlocks": "PHOBOSIA_SOL_04",
    "dayAdvancementTrigger": "HAB_REST_01",
    "requireMissionCompletionBeforeRestAdvancement": true
  },
  "accessPolicy": {
    "accessMode": "physical_trigger_only",
    "remoteSectionAccess": false,
    "allowCrossSectionNavigationFromUI": false,
    "allowOverviewNotifications": true,
    "requireExistingTriggerId": true
  },
  "dataPolicy": {
    "useActualAvailableMarsDataWherePresent": true,
    "requireDatasetProvenance": true,
    "requireSiteMetadata": true,
    "allowClearlyLabelledSimulation": true,
    "neverInventNASAData": true,
    "neverInventCoordinates": true,
    "unknownMetadataMustRemainUnknown": true,
    "hypothesisMustNotBePresentedAsVerifiedFinding": true
  },
  "logSchema": {
    "requiredFields": [
      "logId",
      "title",
      "eventTime",
      "displayLocation",
      "systemName",
      "category",
      "severity",
      "detailedDescription",
      "observations",
      "dataSourceType"
    ],
    "locationRules": {
      "showHumanReadableLocation": true,
      "showInternalFilePaths": false,
      "showJsonFilenames": false,
      "example": "Mission Control — Observation Planning Console"
    }
  },
  "interfaces": [
    {
      "interfaceId": "MISSION_CONTROL_MAIN",
      "location": "Mission Control",
      "triggerId": "MC_MAIN_01",
      "screens": [
        "MissionControl_ObjectivesScreen",
        "MissionControl_OutpostStatusScreen",
        "MissionControl_OverviewScreen"
      ],
      "interfaceMode": "grouped_views_within_one_trigger",
      "views": [
        {
          "viewId": "mission_objectives",
          "screen": "MissionControl_ObjectivesScreen",
          "content": [
            "current_sol",
            "daily_mission_objective",
            "required_tasks",
            "completed_tasks",
            "mission_constraints"
          ]
        },
        {
          "viewId": "outpost_status",
          "screen": "MissionControl_OutpostStatusScreen",
          "content": [
            "overall_outpost_status",
            "validated_sol02_readiness_summary",
            "section_notifications",
            "outstanding_operational_concerns"
          ],
          "restrictions": [
            "Do not expose detailed Engineering system interfaces.",
            "Do not expose detailed Habitat system interfaces."
          ]
        },
        {
          "viewId": "mission_overview",
          "screen": "MissionControl_OverviewScreen",
          "content": [
            "mission_context",
            "current_scientific_phase",
            "available_mission_records",
            "mission_progress"
          ]
        }
      ],
      "mandatoryTasks": ["SOL03_MISSION_CONTEXT"]
    },
    {
      "interfaceId": "MISSION_CONTROL_SYSTEMS",
      "location": "Mission Control",
      "triggerId": "MC_SYSTEMS_01",
      "screens": [
        "MissionControl_CommunicationsScreen",
        "MissionControl_SystemsScreen"
      ],
      "interfaceMode": "single_section",
      "content": [
        "communications_status_if_available",
        "communications_constraints",
        "operational_system_status",
        "observation_planning_constraints",
        "system_logs",
        "warnings",
        "player_review_notes"
      ],
      "mandatoryTasks": ["SOL03_SYSTEM_CONSTRAINTS"]
    },
    {
      "interfaceId": "MISSION_CONTROL_NAVIGATION",
      "location": "Mission Control",
      "triggerId": "MC_NAVIGATION_01",
      "screens": [
        "MissionControl_DroneOperationScreen",
        "MissionControl_ObservationSitesScreen",
        "MissionControl_TerrainMapScreen"
      ],
      "interfaceMode": "grouped_views_within_one_trigger",
      "views": [
        {
          "viewId": "observation_sites",
          "screen": "MissionControl_ObservationSitesScreen",
          "content": [
            "available_observation_sites",
            "site_descriptions",
            "available_site_metadata",
            "site_observation_history",
            "site_related_logs"
          ]
        },
        {
          "viewId": "terrain_map",
          "screen": "MissionControl_TerrainMapScreen",
          "content": [
            "available_terrain_map",
            "terrain_metadata",
            "known_access_constraints",
            "map_observation_markers"
          ]
        },
        {
          "viewId": "drone_operations",
          "screen": "MissionControl_DroneOperationScreen",
          "content": [
            "drone_status",
            "available_drone_information",
            "drone_operation_records"
          ],
          "restrictions": [
            "Sol 3 must not automatically launch the drone.",
            "Do not implement unrequested drone operations as mandatory Sol 3 tasks."
          ]
        }
      ],
      "mandatoryTasks": [
        "SOL03_OBSERVATION_SITE_REVIEW",
        "SOL03_SELECT_TARGET"
      ]
    },
    {
      "interfaceId": "RESEARCH_ANALYSIS",
      "location": "Research Lab",
      "triggerId": "LAB_RESEARCH_ANALYSIS_01",
      "screens": ["ResearchMonitoring_SystemScreen"],
      "interfaceMode": "single_section",
      "content": [
        "available_scientific_datasets",
        "dataset_metadata",
        "data_provenance",
        "measurement_types",
        "coverage_information",
        "dataset_limitations",
        "analysis_workspace",
        "player_analysis_notes"
      ],
      "mandatoryTasks": ["SOL03_DATASET_ANALYSIS"]
    },
    {
      "interfaceId": "RESEARCH_MONITORING",
      "location": "Research Lab",
      "triggerId": "LAB_RESEARCH_MONITORING_01",
      "screens": ["ResearchMonitoring_MainScreen"],
      "interfaceMode": "single_section",
      "content": [
        "research_monitoring_status",
        "research_procedure",
        "research_logs",
        "research_warnings"
      ],
      "mandatoryTasks": []
    }
  ],
  "tasks": [
    {
      "taskId": "SOL03_MISSION_CONTEXT",
      "title": "Review Mission Objectives and Outpost Status",
      "triggerId": "MC_MAIN_01",
      "interfaceId": "MISSION_CONTROL_MAIN",
      "mandatory": true,
      "objective": "Review the scientific mission context, today's objectives, and the validated Sol 2 readiness assessment.",
      "requiredActions": [
        "review_mission_objectives",
        "review_outpost_status",
        "read_sol02_readiness_summary",
        "record_context_notes"
      ],
      "submissionFields": [
        "reviewedMissionRecords",
        "relevantConstraints",
        "playerComment"
      ]
    },
    {
      "taskId": "SOL03_OBSERVATION_SITE_REVIEW",
      "title": "Explore Mars Observation Sites",
      "triggerId": "MC_NAVIGATION_01",
      "interfaceId": "MISSION_CONTROL_NAVIGATION",
      "viewId": "observation_sites",
      "mandatory": true,
      "objective": "Inspect available observation-site information and compare candidates using their available metadata.",
      "requiredActions": [
        "open_observation_sites_view",
        "inspect_site_records",
        "review_available_site_metadata",
        "compare_candidate_sites",
        "record_site_comparison"
      ],
      "comparisonCriteria": [
        "scientific_relevance",
        "data_availability",
        "terrain_information",
        "operational_accessibility",
        "metadata_completeness",
        "known_uncertainties"
      ],
      "submissionFields": [
        "candidateSiteIds",
        "selectedSiteId",
        "comparisonNotes",
        "supportingRecordIds",
        "knownLimitations"
      ]
    },
    {
      "taskId": "SOL03_SYSTEM_CONSTRAINTS",
      "title": "Review Communications and Operational Constraints",
      "triggerId": "MC_SYSTEMS_01",
      "interfaceId": "MISSION_CONTROL_SYSTEMS",
      "mandatory": true,
      "objective": "Review available communication and system information that could affect observation planning.",
      "requiredActions": [
        "review_communications_status",
        "review_operational_systems",
        "inspect_relevant_logs",
        "record_planning_constraints"
      ],
      "submissionFields": [
        "reviewedLogIds",
        "identifiedConstraints",
        "planningImplications",
        "playerComment"
      ]
    },
    {
      "taskId": "SOL03_SELECT_TARGET",
      "title": "Define the Scientific Observation Target",
      "triggerId": "MC_NAVIGATION_01",
      "interfaceId": "MISSION_CONTROL_NAVIGATION",
      "viewId": "observation_sites",
      "mandatory": true,
      "requiresCompletedTasks": [
        "SOL03_OBSERVATION_SITE_REVIEW",
        "SOL03_SYSTEM_CONSTRAINTS"
      ],
      "objective": "Choose a supported observation target and write a focused scientific question.",
      "requiredActions": [
        "select_available_site",
        "write_scientific_question",
        "select_supporting_site_records",
        "identify_uncertainties",
        "submit_target_definition"
      ],
      "submissionFields": [
        "targetId",
        "scientificQuestion",
        "selectionRationale",
        "supportingRecordIds",
        "knownLimitations"
      ],
      "validationRules": [
        "The target must exist in the available site catalogue.",
        "The scientific question must be relevant to the selected target.",
        "Supporting references must resolve to actual records.",
        "Unknown site properties must not be invented."
      ]
    },
    {
      "taskId": "SOL03_DATASET_ANALYSIS",
      "title": "Investigate and Select a Scientific Dataset",
      "triggerId": "LAB_RESEARCH_ANALYSIS_01",
      "interfaceId": "RESEARCH_ANALYSIS",
      "mandatory": true,
      "requiresCompletedTasks": ["SOL03_SELECT_TARGET"],
      "objective": "Inspect available scientific datasets, review their metadata and provenance, and determine whether a dataset is suitable for the selected scientific question.",
      "requiredActions": [
        "open_dataset_catalogue",
        "inspect_dataset_metadata",
        "review_data_provenance",
        "review_spatial_and_temporal_coverage_if_available",
        "evaluate_dataset_relevance",
        "identify_data_limitations",
        "select_dataset",
        "submit_dataset_assessment"
      ],
      "metadataFields": [
        "datasetId",
        "title",
        "provider",
        "source",
        "productType",
        "measurementType",
        "units",
        "spatialCoverage",
        "temporalCoverage",
        "resolution",
        "processingLevel",
        "provenance",
        "limitations"
      ],
      "submissionFields": [
        "datasetId",
        "relevanceExplanation",
        "supportingMetadata",
        "knownLimitations",
        "playerComment"
      ],
      "validationRules": [
        "The dataset must exist in the available catalogue.",
        "The dataset must be relevant to the selected target and question.",
        "Missing metadata must be labelled unavailable.",
        "The player must not claim that a dataset proves a result beyond its capabilities."
      ]
    },
    {
      "taskId": "SOL03_SUBMIT_TARGET_PROPOSAL",
      "title": "Submit the Scientific Observation Proposal",
      "triggerId": "MC_MAIN_01",
      "interfaceId": "MISSION_CONTROL_MAIN",
      "mandatory": true,
      "requiresCompletedTasks": [
        "SOL03_MISSION_CONTEXT",
        "SOL03_OBSERVATION_SITE_REVIEW",
        "SOL03_SYSTEM_CONSTRAINTS",
        "SOL03_SELECT_TARGET",
        "SOL03_DATASET_ANALYSIS"
      ],
      "objective": "Review and submit the final scientific target proposal with its supporting site records, selected dataset, rationale and known limitations.",
      "submissionFields": [
        "targetId",
        "scientificQuestion",
        "datasetId",
        "selectionRationale",
        "supportingRecordIds",
        "operationalConstraints",
        "knownLimitations"
      ],
      "validationRules": [
        "The selected target and dataset must exist.",
        "The question must be nonempty and relevant.",
        "Supporting records must exist.",
        "Known limitations must be included.",
        "The proposal must not present a hypothesis as an established scientific result."
      ]
    }
  ],
  "missionCompletion": {
    "requiredTasks": [
      "SOL03_MISSION_CONTEXT",
      "SOL03_OBSERVATION_SITE_REVIEW",
      "SOL03_SYSTEM_CONSTRAINTS",
      "SOL03_SELECT_TARGET",
      "SOL03_DATASET_ANALYSIS",
      "SOL03_SUBMIT_TARGET_PROPOSAL"
    ],
    "requireValidSubmittedRecords": true,
    "requireEvidenceReferences": true,
    "requireKnownLimitations": true,
    "unlockNextSol": "PHOBOSIA_SOL_04"
  }
}