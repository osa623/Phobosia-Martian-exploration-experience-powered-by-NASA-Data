      "title": "Repair Main Solar Power Connection",
      "zone": "Outdoor Solar Panel Area",
      "mandatory": true,
      "trigger": "PowerUnit_AB_Main",
      "objective": "Activate the existing main solar connection repair trigger and complete the interactive power-routing simulation that connects both solar panel outputs to the main power distribution line.",
