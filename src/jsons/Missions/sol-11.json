{
  "missionId": "PHOBOSIA_SOL_11",
  "sol": 11,
  "title": "SOL 11 - Final Farewell",
  "subtitle": "The Final Departure",
  "missionType": "final_expedition_departure",
  "description": "The final day at PHOBOSIA Outpost. The player receives an incoming message from Selina, an astronaut who has departed from Deimosian Outpost and is travelling towards PHOBOSIA Outpost. Her journey will take several hours. The player does not wait for her arrival. After acknowledging the message, the player writes the final expedition log at Mission Control, prepares for the final EVA, collects the existing EVA suit, enters the assigned vehicle and follows a visible 200-metre departure route towards an unnamed outpost. The final route ends the playable outpost scene and triggers the mandatory final cinematic.",
  "missionStatus": "locked",
  "missionCategory": "final_story_mission",
  "isFinalMission": true,

  "prerequisites": {
    "requiredCompletedMission": "PHOBOSIA_SOL_10",
    "required": true,
    "preservePreviousSOLProgress": true
  },

