  "tasks": [
    {
      "taskId": "SOL11_TASK_01",
      "order": 1,
      "title": "Receive Selina's Message",
      "description": "Go to the existing Mission Control main console and review the incoming message from Selina. She has departed from Deimosian Outpost and is travelling towards PHOBOSIA Outpost. Her journey will take several hours.",
      "zone": "MissionControl",
      "required": true,
      "interaction": "existing_mission_control_interaction",
      "completionCondition": "The incoming message is displayed and acknowledged by the player.",
      "completionEvent": "SOL11_SELINA_MESSAGE_ACKNOWLEDGED",
      "waitForSelina": false,
      "requireSelinaArrival": false,
      "requirePlayerReply": false,
      "requireDepartureConfirmation": false
    },
    {
      "taskId": "SOL11_TASK_02",
      "order": 2,
      "title": "Write the Final Mission Log",
      "description": "Remain at Mission Control and write your final personal expedition log. Reflect on the observations, discoveries and experiences recorded throughout SOL 1 to SOL 10. Submit your own final message to complete the last mission record.",
      "zone": "MissionControl",
      "required": true,
      "interaction": "existing_mission_control_interaction",
      "input": {
        "type": "multiline_text",
        "required": true,
        "minimumLength": 1,
        "maximumLength": 5000,
        "placeholder": "Write your final expedition log...",
        "submitLabel": "Submit Final Log",
        "allowPlayerTyping": true,
        "allowEditingBeforeSubmission": true
      },
      "completionCondition": "The player submits a non-empty final mission log and the submitted text is successfully persisted.",
      "completionEvent": "SOL11_FINAL_LOG_SUBMITTED"
    },
    {
      "taskId": "SOL11_TASK_03",
      "order": 3,
      "title": "Prepare for the Final EVA",
      "description": "Leave Mission Control and go to the existing EVA section. Collect or equip the existing EVA suit before heading outside.",
      "zone": "Airlock",
      "required": true,
      "interaction": "existing_EVA_suit_interaction",
      "completionCondition": "The existing EVA suit interaction reports successful collection or equipment.",
      "completionEvent": "SOL11_EVA_SUIT_COLLECTED",
      "createNewSuit": false,
      "createNewEVASection": false
    },
    {
      "taskId": "SOL11_TASK_04",
      "order": 4,
      "title": "Enter Your Expedition Vehicle",
      "description": "After preparing the EVA suit, go outside and reach the existing vehicle assigned to the player. Enter that vehicle to begin the final departure.",
      "zone": "Master_Terrain",
      "required": true,
      "interaction": "existing_vehicle_entry_interaction",
      "vehicleReference": "resolve_existing_assigned_player_vehicle",
      "completionCondition": "The player successfully enters the existing assigned vehicle.",
      "completionEvent": "SOL11_VEHICLE_ENTERED",
      "createNewVehicle": false
    },
    {
      "taskId": "SOL11_TASK_05",
      "order": 5,
      "title": "The Final 200 Metres",
      "description": "Drive the assigned vehicle along the visible route beam. Follow the marked departure path for approximately 200 metres away from PHOBOSIA Outpost. When the complete route has been travelled, the playable outpost scene will end.",
      "zone": "Master_Terrain",
      "required": true,
      "targetDistanceMeters": 200,
      "routeConfiguration": "SOL11_FINAL_DEPARTURE_ROUTE",
      "completionCondition": "The actual vehicle travel distance along the configured route reaches 200 metres.",
      "completionEvent": "SOL11_FINAL_ROUTE_COMPLETED"
    },
    {
      "taskId": "SOL11_TASK_06",
      "order": 6,
      "title": "Final Farewell",
      "description": "After completing the final departure route, watch the complete final cinematic. The video cannot be skipped.",
      "zone": "FinalCinematic",
      "required": true,
      "mediaReference": "SOL11_FINAL_VIDEO",
      "completionCondition": "The final video reaches its actual ended event.",
      "completionEvent": "SOL11_FINAL_VIDEO_COMPLETED"
    }
  ],

